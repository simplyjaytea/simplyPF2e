<div class="simplypf2e-generator">
  {{! The parent registers this shared partial once during module startup. }}
  {{> simplypf2e-provider-header itemForgeMode=true}}

  <fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
    <legend>{{localize "SIMPLYPF2E.ItemForge.ConceptLegend"}}</legend>
    <div class="spf-kind-choices" role="group" aria-label="{{localize 'SIMPLYPF2E.ItemForge.Kind'}}">
      {{#each kinds}}
        <button type="button" class="spf-kind-choice {{#if this.selected}}spf-kind-selected{{/if}}" data-action="selectKind" data-kind="{{this.value}}" aria-pressed="{{this.selected}}" {{#if @root.busy}}disabled{{/if}}>
          <i class="fa-solid {{this.icon}}" aria-hidden="true"></i>
          <span class="spf-kind-choice-copy">
            <strong>{{localize this.label}}</strong>
            <small>{{localize this.hint}}</small>
          </span>
        </button>
      {{/each}}
    </div>
    <div class="form-group stacked">
      <label for="spf-itemforge-prompt">{{localize "SIMPLYPF2E.ItemForge.Prompt"}}</label>
      <textarea id="spf-itemforge-prompt" name="prompt" rows="3" placeholder="{{localize 'SIMPLYPF2E.ItemForge.PromptPlaceholder'}}">{{input.prompt}}</textarea>
    </div>
    <div class="spf-row">
      <div class="form-group">
        <label for="spf-itemforge-level">{{localize "SIMPLYPF2E.ItemForge.Level"}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYPF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.LevelDown'}}">
            <i class="fa-solid fa-minus" aria-hidden="true"></i>
          </button>
          <input id="spf-itemforge-level" type="number" name="level" min="{{minLevel}}" max="{{maxLevel}}" step="1" value="{{input.level}}">
          <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYPF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.LevelUp'}}">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="spf-itemforge-rarity">{{localize "SIMPLYPF2E.Generator.Rarity"}}</label>
        <select id="spf-itemforge-rarity" name="rarity">
          {{#each rarities}}
            <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="spf-generate-row">
      <button type="button" class="{{#unless hasPreview}}{{#unless created}}spf-primary{{/unless}}{{/unless}} spf-generate-action" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i>
        {{localize "SIMPLYPF2E.ItemForge.GeneratePlan"}}
      </button>
      <button type="button" class="spf-secondary spf-source-button" data-action="configureSources" data-tooltip="{{localize 'SIMPLYPF2E.Generator.ConfigureSources'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.ConfigureSources'}}" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-book-atlas" aria-hidden="true"></i>
        <span class="spf-button-label">{{localize "SIMPLYPF2E.Generator.ConfigureSourcesShort"}}</span>
      </button>
    </div>
  </fieldset>

  {{#if unavailableNote}}
    <p class="notification warning" role="status">{{unavailableNote}}</p>
  {{/if}}

  {{#if progress}}{{> simplypf2e-progress}}{{else if busy}}{{> simplypf2e-progress}}{{/if}}

  {{#if error}}
    <p class="notification error" role="alert">{{error}}</p>
  {{/if}}

  {{#if created}}
  <section class="spf-complete spf-card" aria-label="{{localize 'SIMPLYPF2E.ItemForge.CreatedTitle'}}">
    <div class="spf-complete-heading">
      <span class="spf-complete-sigil" aria-hidden="true"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
      <div>
        <h2>{{localize "SIMPLYPF2E.ItemForge.CreatedTitle"}}</h2>
        <p>{{localize "SIMPLYPF2E.ItemForge.CreatedSummary" name=created.name}}</p>
      </div>
    </div>
    {{#if created.warning}}
      <p class="notification warning" role="status">{{localize "SIMPLYPF2E.ItemForge.CreatedWarning"}}</p>
    {{/if}}
    <footer class="spf-actions">
      {{#if created.itemId}}
        <button type="button" class="spf-primary" data-action="openCreatedItem">
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{localize "SIMPLYPF2E.ItemForge.OpenItem"}}
        </button>
      {{/if}}
      <button type="button" class="{{#unless created.itemId}}spf-primary{{/unless}}" data-action="forgeAnother">
        <i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "SIMPLYPF2E.ItemForge.ForgeAnother"}}
      </button>
    </footer>
  </section>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{localize "SIMPLYPF2E.ItemForge.EmptyHint"}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card">
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYPF2E.ItemForge.Item"}} {{preview.concept.level}}</span>
    </header>
    <div class="spf-traits">
      {{#each preview.traits}}<span class="spf-trait">{{this}}</span>{{/each}}
    </div>

    {{#if preview.runed}}
      <div class="spf-statline">
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Price"}}</strong> {{preview.price}}</span>
      </div>

      <h3>{{localize "SIMPLYPF2E.ItemForge.RunesHeading"}}</h3>
      <ul class="spf-list">
        <li>{{localize "SIMPLYPF2E.ItemForge.Potency"}} +{{preview.potency}}</li>
        {{#if preview.secondary}}<li>{{localize "SIMPLYPF2E.ItemForge.SecondaryTier"}} {{preview.secondary}}</li>{{/if}}
        {{#each preview.propertyRunes}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    {{else}}
      <div class="spf-statline">
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Usage"}}</strong> {{preview.usage}}{{#if preview.invested}} ({{localize "SIMPLYPF2E.ItemForge.Invested"}}){{/if}}</span>
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Bulk"}}</strong> {{preview.bulk}}</span>
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Price"}}</strong> {{preview.price}}</span>
      </div>

      {{#if preview.hasEffects}}
        <h3>{{localize "SIMPLYPF2E.ItemForge.EffectsHeading"}}</h3>
        <ul class="spf-list">
          {{#each preview.effects}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}
        {{#unless preview.activation}}
          <p class="notification warning" role="status">{{localize "SIMPLYPF2E.ItemForge.NoEffects"}}</p>
        {{/unless}}
      {{/if}}

      {{#if preview.activation}}
        <h3>{{localize "SIMPLYPF2E.ItemForge.ActivationHeading"}}</h3>
        <ul class="spf-list">
          {{!-- describeActivation()'s free-text params (duration, effectName)
               are HTML-escaped once at normalize time so the same string is
               safe in the macro body's raw-HTML sinks; triple-stache here
               avoids Handlebars escaping them a second time. Everything else
               in the string is enum/dice/localized text. --}}
          <li>{{{preview.activation}}}</li>
        </ul>
      {{/if}}
    {{/if}}

    {{#if preview.concept.description}}
      <h3>{{localize "SIMPLYPF2E.Preview.Description"}}</h3>
      <p class="spf-description">{{preview.concept.description}}</p>
    {{/if}}

    {{#if tokenReport}}
      <details class="spf-token-report">
        <summary><span>{{localize "SIMPLYPF2E.Tokens.Heading"}}</span><strong>{{tokenReport.totalText}}</strong></summary>
        <ul>
          {{#each tokenReport.steps}}
            <li><strong>{{this.label}}</strong> — {{this.text}}</li>
          {{/each}}
        </ul>
      </details>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createItem" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-box-open" aria-hidden="true"></i> {{localize "SIMPLYPF2E.ItemForge.CreateItem"}}
      </button>
      <button type="button" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "SIMPLYPF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
</div>
