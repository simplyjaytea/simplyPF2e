<div class="simplypf2e-generator">
  {{! The parent registers this shared partial once during module startup. }}
  {{> simplypf2e-provider-header itemForgeMode=true}}

  <fieldset class="spf-inputs spf-card" {{#if busy}}disabled{{/if}}>
    <legend>{{localize "SIMPLYPF2E.ItemForge.ConceptLegend"}}</legend>
    <div class="spf-kind-choices" role="group" aria-label="{{localize 'SIMPLYPF2E.ItemForge.Kind'}}">
      {{#each kinds}}
        <button type="button" class="spf-kind-choice {{#if this.selected}}spf-kind-selected{{/if}}" data-action="selectKind" data-kind="{{this.value}}" aria-pressed="{{this.selected}}" {{#if @root.busy}}disabled{{/if}}>
          <i class="fa-solid {{this.icon}}" aria-hidden="true"></i>
          <span class="spf-kind-choice-copy">
            <strong>{{localize this.label}}</strong>
            <small>{{localize this.hint}}</small>
          </span>
        </button>
      {{/each}}
      {{#each consumableKinds}}
        <button type="button" class="spf-kind-choice {{#if this.selected}}spf-kind-selected{{/if}}" data-action="selectKind" data-kind="{{this.value}}" aria-pressed="{{this.selected}}" {{#if @root.busy}}disabled{{/if}}>
          <i class="fa-solid {{this.icon}}" aria-hidden="true"></i>
          <span class="spf-kind-choice-copy">
            <strong>{{localize this.label}}</strong>
            <small>{{localize this.hint}}</small>
          </span>
        </button>
      {{/each}}
    </div>
    <div class="form-group stacked">
      <label for="spf-itemforge-prompt">{{localize promptLabel}}</label>
      <textarea id="spf-itemforge-prompt" name="prompt" rows="3" placeholder="{{localize promptPlaceholder}}">{{input.prompt}}</textarea>
    </div>
    <div class="spf-row">
      {{#unless isCantripDeck}}
      <div class="form-group">
        <label for="spf-itemforge-level">{{localize levelLabel}}</label>
        <div class="spf-level-controls">
          <button type="button" class="spf-icon-btn" data-action="levelDown" data-tooltip="{{localize 'SIMPLYPF2E.Generator.LevelDown'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.LevelDown'}}">
            <i class="fa-solid fa-minus" aria-hidden="true"></i>
          </button>
          <input id="spf-itemforge-level" type="number" name="level" min="{{minLevel}}" max="{{maxLevel}}" step="1" value="{{input.level}}">
          <button type="button" class="spf-icon-btn" data-action="levelUp" data-tooltip="{{localize 'SIMPLYPF2E.Generator.LevelUp'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.LevelUp'}}">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      {{/unless}}
      <div class="form-group">
        <label for="spf-itemforge-rarity">{{localize "SIMPLYPF2E.Generator.Rarity"}}</label>
        <select id="spf-itemforge-rarity" name="rarity">
          {{#each rarities}}
            <option value="{{this.value}}" {{#if (eq this.value @root.input.rarity)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    {{#if showDestination}}<div class="form-group spf-loot-destination"><label for="spf-destination">{{localize "SIMPLYPF2E.ItemForge.Loot.CreateAs"}}</label><select id="spf-destination" name="destination"><option value="items" {{#if (eq input.destination "items")}}selected{{/if}}>{{localize "SIMPLYPF2E.ItemForge.Loot.Items"}}</option><option value="loot" {{#if (eq input.destination "loot")}}selected{{/if}}>{{localize "SIMPLYPF2E.ItemForge.Loot.Actor"}}</option></select></div>{{/if}}
    {{#if showContainer}}<div class="form-group spf-loot-name"><label for="spf-container">{{localize "SIMPLYPF2E.ItemForge.Loot.Name"}}</label><input id="spf-container" name="containerName" maxlength="100" value="{{input.containerName}}"></div><div class="form-group spf-loot-sheet"><label for="spf-loot-sheet">{{localize "SIMPLYPF2E.ItemForge.Loot.Sheet"}}</label><select id="spf-loot-sheet" name="lootSheetType"><option value="Loot" {{#if (eq input.sheetType "Loot")}}selected{{/if}}>{{localize "SIMPLYPF2E.ItemForge.Loot.SheetLoot"}}</option><option value="Merchant" {{#if (eq input.sheetType "Merchant")}}selected{{/if}}>{{localize "SIMPLYPF2E.ItemForge.Loot.SheetMerchant"}}</option></select></div>{{/if}}
    {{#if isParcel}}<div class="form-group spf-parcel-size"><label for="spf-party-size">{{localize "SIMPLYPF2E.ItemForge.Parcel.PartySize"}}</label><input id="spf-party-size" type="number" name="partySize" min="1" max="8" step="1" value="{{input.partySize}}"></div>{{/if}}
    {{#if isParcel}}<div class="form-group spf-parcel-valuables"><label class="spf-checkbox-label"><input type="checkbox" name="valuables" aria-describedby="spf-valuables-hint" {{#if input.valuables}}checked{{/if}}> <span>{{localize "SIMPLYPF2E.ItemForge.Parcel.Valuables"}}</span></label><p id="spf-valuables-hint" class="spf-hint">{{localize "SIMPLYPF2E.ItemForge.Parcel.ValuablesHint"}}</p></div>{{/if}}
    <div class="spf-generate-row">
      <button type="button" class="{{#unless hasPreview}}{{#unless created}}spf-primary{{/unless}}{{/unless}} spf-generate-action" data-action="generate" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i>
        {{localize "SIMPLYPF2E.ItemForge.GeneratePlan"}}
      </button>
      <button type="button" class="spf-secondary spf-source-button" data-action="configureSources" data-tooltip="{{localize 'SIMPLYPF2E.Generator.ConfigureSources'}}" aria-label="{{localize 'SIMPLYPF2E.Generator.ConfigureSources'}}" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-book-atlas" aria-hidden="true"></i>
        <span class="spf-button-label">{{localize "SIMPLYPF2E.Generator.ConfigureSourcesShort"}}</span>
      </button>
    </div>
  </fieldset>

  {{#if unavailableNote}}
    <p class="notification warning" role="status">{{unavailableNote}}</p>
  {{/if}}

  {{#if progress}}{{> simplypf2e-progress}}{{else if busy}}{{> simplypf2e-progress}}{{/if}}

  {{#if error}}
    <p class="notification error" role="alert">{{error}}</p>
  {{/if}}

  {{#if created}}
  <section class="spf-complete spf-card" aria-label="{{localize 'SIMPLYPF2E.ItemForge.CreatedTitle'}}">
    <div class="spf-complete-heading">
      <span class="spf-complete-sigil" aria-hidden="true"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
      <div>
        <h2>{{localize "SIMPLYPF2E.ItemForge.CreatedTitle"}}</h2>
        <p>{{localize "SIMPLYPF2E.ItemForge.CreatedSummary" name=created.name}}</p>
        {{#if created.names}}<ul class="spf-list">{{#each created.names}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
      </div>
    </div>
    {{#if created.warning}}
      <p class="notification warning" role="status">{{localize "SIMPLYPF2E.ItemForge.CreatedWarning"}}</p>
    {{/if}}
    <footer class="spf-actions">
      {{#if created.itemId}}
        <button type="button" class="spf-primary" data-action="openCreatedItem">
          <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> {{localize "SIMPLYPF2E.ItemForge.OpenItem"}}
        </button>
      {{/if}}
      {{#if created.actorId}}<button type="button" class="spf-primary" data-action="openCreatedActor">{{localize "SIMPLYPF2E.ItemForge.Loot.Open"}}</button>{{/if}}
      <button type="button" class="{{#unless created.itemId}}{{#unless created.actorId}}spf-primary{{/unless}}{{/unless}}" data-action="forgeAnother">
        <i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "SIMPLYPF2E.ItemForge.ForgeAnother"}}
      </button>
    </footer>
  </section>
  {{/if}}

  {{#if showEmptyState}}
    <p class="spf-empty">{{localize "SIMPLYPF2E.ItemForge.EmptyHint"}}</p>
  {{/if}}

  {{#if preview}}
  <section class="spf-preview spf-card">
    {{#if preview.parcel}}
      <h2>{{localize "SIMPLYPF2E.ItemForge.Parcel.Preview"}}</h2>
      <table class="spf-parcel-table"><thead><tr><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Level"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Parcel.SlotLevels"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Parcel.Scroll"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Rank"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Price"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Parcel.Quantity"}}</th></tr></thead><tbody>{{#each preview.items}}<tr><td>{{this.level}}</td><td>{{this.itemLevels}}</td><td>{{this.name}}</td><td>{{this.rank}}</td><td>{{this.price}}</td><td>{{this.quantity}}</td></tr>{{/each}}</tbody></table>
      {{#each preview.unfilled}}<p class="notification warning">{{localize "SIMPLYPF2E.ItemForge.Parcel.Unfilled" level=this.itemLevel rank=this.rank}}</p>{{/each}}
      {{#each preview.warnings}}<p class="notification warning">{{this}}</p>{{/each}}
      {{#if preview.currency}}<p>{{localize "SIMPLYPF2E.ItemForge.Parcel.Currency" coins=preview.currency}}</p>{{/if}}{{#if preview.coinsMissing}}<p class="notification warning" role="status">{{preview.coinsMissing}}</p>{{/if}}{{#if preview.valuable}}<p>{{localize "SIMPLYPF2E.ItemForge.Parcel.ValuableLine" name=preview.valuable.name price=preview.valuable.price}}</p>{{/if}}{{#if preview.valuableNote}}<p class="notification warning" role="status">{{preview.valuableNote}}</p>{{/if}}<h3>{{localize "SIMPLYPF2E.ItemForge.Parcel.PermanentHeading"}}</h3><p>{{preview.permanentSummary}}</p><div class="spf-table-scroll"><table class="spf-parcel-table spf-permanent-table"><thead><tr><th scope="col">{{localize "SIMPLYPF2E.ItemForge.Parcel.PermanentLevels"}}</th><th scope="col">{{localize "SIMPLYPF2E.ItemForge.Parcel.PermanentFilled"}}</th><th scope="col">{{localize "SIMPLYPF2E.ItemForge.Parcel.PermanentKindHeader"}}</th><th scope="col">{{localize "SIMPLYPF2E.ItemForge.Parcel.PermanentItemLevel"}}</th><th scope="col">{{localize "SIMPLYPF2E.ItemForge.Consumables.Price"}}</th></tr></thead><tbody>{{#each preview.permanents}}<tr><td>{{this.levels}}</td><td>{{#if this.filled}}{{this.name}}{{else}}<span class="notification warning">{{localize "SIMPLYPF2E.ItemForge.Parcel.UnfilledPermanent" reason=this.reason}}</span>{{/if}}</td><td>{{this.kind}}</td><td>{{this.itemLevel}}</td><td>{{this.price}}</td></tr>{{/each}}</tbody></table></div><p>{{#if preview.extraPcs}}{{localize "SIMPLYPF2E.ItemForge.Parcel.ValueExtra" value=preview.valueGp total=preview.totalGp}}{{else}}{{localize "SIMPLYPF2E.ItemForge.Parcel.Value" value=preview.valueGp total=preview.totalGp}}{{/if}}</p>
    {{else if preview.consumable}}
      <header class="spf-statblock-header">
        <h2>{{preview.heading}}</h2>
      </header>
      <table class="spf-consumables">
        <thead>
          <tr><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Spell"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Rank"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Price"}}</th><th>{{localize "SIMPLYPF2E.ItemForge.Consumables.Level"}}</th></tr>
        </thead>
        <tbody>
          {{#each preview.items}}
            <tr><td>{{this.name}}</td><td>{{this.rank}}</td><td>{{this.price}}</td><td>{{this.level}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if preview.isCantripDeck}}<p>{{localize "SIMPLYPF2E.ItemForge.Consumables.DeckNote"}}</p>{{/if}}
      {{#if preview.destination}}<p>{{preview.destination}}</p>{{/if}}
      {{#each preview.warnings}}
        <p class="notification warning" role="status">{{this}}</p>
      {{/each}}
    {{else}}
    <header class="spf-statblock-header">
      <h2>{{preview.concept.name}}</h2>
      <span class="spf-level">{{localize "SIMPLYPF2E.ItemForge.Item"}} {{preview.concept.level}}</span>
    </header>
    <div class="spf-traits">
      {{#each preview.traits}}<span class="spf-trait">{{this}}</span>{{/each}}
    </div>

    {{#if preview.runed}}
      <div class="spf-statline">
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Price"}}</strong> {{preview.price}}</span>
      </div>

      <h3>{{localize "SIMPLYPF2E.ItemForge.RunesHeading"}}</h3>
      <ul class="spf-list">
        <li>{{localize "SIMPLYPF2E.ItemForge.Potency"}} +{{preview.potency}}</li>
        {{#if preview.secondary}}<li>{{localize "SIMPLYPF2E.ItemForge.SecondaryTier"}} {{preview.secondary}}</li>{{/if}}
        {{#each preview.propertyRunes}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    {{else}}
      <div class="spf-statline">
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Usage"}}</strong> {{preview.usage}}{{#if preview.invested}} ({{localize "SIMPLYPF2E.ItemForge.Invested"}}){{/if}}</span>
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Bulk"}}</strong> {{preview.bulk}}</span>
        <span><strong>{{localize "SIMPLYPF2E.ItemForge.Price"}}</strong> {{preview.price}}</span>
      </div>

      {{#if preview.hasEffects}}
        <h3>{{localize "SIMPLYPF2E.ItemForge.EffectsHeading"}}</h3>
        <ul class="spf-list">
          {{#each preview.effects}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}
        {{#unless preview.activation}}
          <p class="notification warning" role="status">{{localize "SIMPLYPF2E.ItemForge.NoEffects"}}</p>
        {{/unless}}
      {{/if}}

      {{#if preview.activation}}
        <h3>{{localize "SIMPLYPF2E.ItemForge.ActivationHeading"}}</h3>
        <ul class="spf-list">
          {{!-- describeActivation()'s free-text params (duration, effectName)
               are HTML-escaped once at normalize time so the same string is
               safe in the macro body's raw-HTML sinks; triple-stache here
               avoids Handlebars escaping them a second time. Everything else
               in the string is enum/dice/localized text. --}}
          <li>{{{preview.activation}}}</li>
        </ul>
      {{/if}}
    {{/if}}
    {{/if}}

    {{#if preview.concept.description}}
      <h3>{{localize "SIMPLYPF2E.Preview.Description"}}</h3>
      <p class="spf-description">{{preview.concept.description}}</p>
    {{/if}}

    {{#if tokenReport}}
      <details class="spf-token-report">
        <summary><span>{{localize "SIMPLYPF2E.Tokens.Heading"}}</span><strong>{{tokenReport.totalText}}</strong></summary>
        <ul>
          {{#each tokenReport.steps}}
            <li><strong>{{this.label}}</strong> — {{this.text}}</li>
          {{/each}}
        </ul>
      </details>
    {{/if}}

    <footer class="spf-actions">
      <button type="button" class="spf-primary" data-action="createItem" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-box-open" aria-hidden="true"></i> {{localize "SIMPLYPF2E.ItemForge.CreateItem"}}
      </button>
      <button type="button" data-action="discard" {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "SIMPLYPF2E.Generator.Discard"}}
      </button>
    </footer>
  </section>
  {{/if}}
</div>
