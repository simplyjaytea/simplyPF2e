<div class="simplypf2e-sources">
  <header class="spf-app-intro">
    <span class="spf-app-sigil" aria-hidden="true"><i class="fa-solid fa-book-atlas" aria-hidden="true"></i></span>
    <div>
      <p class="spf-eyebrow">{{localize "SIMPLYPF2E.Sources.Title"}}</p>
      <p class="spf-hint">{{localize "SIMPLYPF2E.Sources.Hint"}}</p>
    </div>
  </header>

  {{#each categories}}
    <fieldset class="spf-source-category spf-card">
      <legend><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{localize this.label}}</legend>
      {{#if this.packs.length}}
        {{#each this.packs}}
          <label class="spf-pack">
            <input type="checkbox" data-category="{{../key}}" data-pack="{{this.id}}" {{#if this.checked}}checked{{/if}}>
            <span class="spf-pack-copy"><span class="spf-pack-title">{{this.title}}</span>
            <span class="spf-pack-source">{{this.package}}{{#if this.isDefault}} &middot; {{localize "SIMPLYPF2E.Sources.Default"}}{{/if}}</span>
            </span>
          </label>
        {{/each}}
      {{else}}
        <p class="spf-hint">{{localize "SIMPLYPF2E.Sources.NonePacksFound"}}</p>
      {{/if}}
    </fieldset>
  {{/each}}

  {{#if feedback}}
    <p class="notification spf-feedback spf-feedback-{{feedback.kind}}" role="{{#if feedback.role}}{{feedback.role}}{{else}}status{{/if}}" aria-live="{{#if (eq feedback.kind 'error')}}assertive{{else}}polite{{/if}}">
      <i class="fa-solid {{#if feedback.icon}}{{feedback.icon}}{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>
      <span>{{feedback.text}}</span>
    </p>
  {{/if}}

  <footer class="spf-actions">
    <button type="submit" class="spf-primary">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "SIMPLYPF2E.Sources.Save"}}
    </button>
    <button type="button" data-action="reset">
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "SIMPLYPF2E.Sources.Reset"}}
    </button>
  </footer>
</div>
